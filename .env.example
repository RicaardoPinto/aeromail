# Clave maestra para cifrar las credenciales de correo dentro del token de
# sesión (AES-256-GCM). Obligatoria: el servicio no arranca sin ella.
# Genera una con:  openssl rand -base64 48
APP_SECRET=

# Puerto del servidor
PORT=3000

# Directorio de persistencia para firmas y configuraciones
DATA_DIR=./data

# Entorno de ejecución
NODE_ENV=production

# --- Servidor de correo por defecto ---------------------------------------
# Sin estas variables se asume `mail.<dominio-del-correo>`, que durante una
# migración suele apuntar al servidor antiguo. Fijarlas evita que cada persona
# tenga que escribir el servidor a mano al iniciar sesión.
DEFAULT_IMAP_HOST=
DEFAULT_SMTP_HOST=

# --- TLS hacia el servidor de correo ---------------------------------------
# Por defecto se exige certificado válido. Poner `true` desactiva esa
# verificación y SOLO tiene sentido cuando el webmail habla con el servidor de
# correo por la red interna de Docker, donde nadie puede interponerse y el
# certificado suele ser autofirmado.
# Nunca lo actives contra un servidor alcanzable desde internet.
MAIL_TLS_INSECURE=false

# --- Modo demostración ------------------------------------------------------
# Se salta la verificación de credenciales, así que queda inhabilitado en
# producción aunque se ponga en `true`. Solo acepta direcciones @demo.local.
DEMO_MODE=false
